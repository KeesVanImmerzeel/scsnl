.Qpiek_100jr <- function(x,
df = Extreme_buien_table) {
x <- Qpiek_100jr(df, x['bmax'], x['L'], x['i']) |> dplyr::slice(which.max(Qpiek))
return(x[1,]$Qpiek)
}
