.Qpiek_100jr <- function(x,
df = Extreme_buien_table) {
res <- Qpiek_100jr(df, x['bmax'], x['L'], x['i']) |> dplyr::slice(which.max(Qpiek))
res <- c(Tpiek=res[1,]$Tpiek, Qpiek=res[1,]$Qpiek)
return(res)
}
